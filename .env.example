# Todas as variáveis deste arquivo são OPCIONAIS.
#
# Sem nenhuma delas o site roda por completo, menos as duas ferramentas de
# Áudio & Voz e o bot do Telegram. Copie para `.env` só se precisar de algo.
#
# Every variable here is OPTIONAL. Without any of them the site runs fully,
# except for the two Audio & Voice tools and the Telegram bot.

# =============================================================== SITE (build)
# Lidas pelo Vite no build e gravadas no JavaScript do site. Por isso aqui só
# entra o que pode ser público.

# Trava de domínio: hostnames onde a aplicação pode rodar, separados por
# vírgula. Vazio desliga a trava, que é o esperado em auto-hospedagem e em
# deploys de preview. Um item iniciado por "." libera também os subdomínios.
# Exemplo: VITE_ALLOWED_HOSTS=tools.matheusmarx.com.br
VITE_ALLOWED_HOSTS=

# ========================================================= SERVIDOR (api/)
# Lidas só pelas funções em `api/`, na Vercel. NUNCA vão para o navegador.
# Na Vercel, cadastre em Settings → Environment Variables; não use o prefixo
# VITE_ nelas, ou o valor acaba gravado no JavaScript público.

# Chave da Groq, usada na transcrição (Whisper) e no texto para fala (Orpheus).
# Onde achar: https://console.groq.com/keys → Create API Key.
# Formato: começa com "gsk_".
GROQ_API_KEY=

# Redis para o limite por IP e para o estado do bot. A integração do Upstash no
# marketplace da Vercel cadastra estas variáveis sozinha, com nomes KV_REST_API_*
# — o código aceita esses e também os UPSTASH_REDIS_REST_* abaixo.
# Sem Redis, tudo funciona com memória local, que serve para desenvolvimento.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------- bot do Telegram
# Token do BOT, que o @BotFather entrega ao criar o bot. Não é o seu id de
# usuário. Formato: <id-numérico-do-bot>:<sequência de ~35 caracteres>.
TELEGRAM_BOT_TOKEN=

# Ids dos chats que podem usar o bot, separados por vírgula. É o id da SUA
# conta (ou de um grupo), não o do bot. Vazio = ninguém usa o bot.
# Para descobrir: npm run telegram chat-id
TELEGRAM_ALLOWED_CHAT_IDS=

# ================================================================ rastreamento
# Não existe. Não há variável de analytics aqui porque o projeto não carrega
# rastreador nenhum, nem na instalação oficial — não é um padrão que se possa
# ligar, é código que não está no repositório.
